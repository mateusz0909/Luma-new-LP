{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/guide",
      "destination": "/guide/wim-hof-method",
      "permanent": true
    },
    {
      "source": "/science",
      "destination": "/science-and-safety",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|screenshots/|video/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(screenshots|video)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
